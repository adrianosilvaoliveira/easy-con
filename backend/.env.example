# Application
NODE_ENV=development
PORT=3333
API_URL=http://localhost:3333

# Database (PostgreSQL — obrigatório)
# Local / Docker (DIRECT_URL = mesma URL para migrations):
DATABASE_URL=postgresql://hospital:hospital_secret@localhost:5432/hospital_stock?schema=public
DIRECT_URL=postgresql://hospital:hospital_secret@localhost:5432/hospital_stock?schema=public

# Produção (Supabase na Vercel Storage — prefixo ARMAZENAMENTO_*):
# ARMAZENAMENTO_POSTGRES_PRISMA_URL → DATABASE_URL (pooler 6543)
# ARMAZENAMENTO_POSTGRES_URL_NON_POOLING → DIRECT_URL (direto 5432)
# Ou defina manualmente:
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Hospital
HOSPITAL_NAME=Hospital Oftalmológico Visão Clara
HOSPITAL_CNPJ=00.000.000/0001-00
HOSPITAL_ADDRESS=Rua da Saúde, 1000 - São Paulo, SP

# Email (password recovery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hospital.com

# CORS (opcional; padrão = API_URL — mesmo servidor)
# FRONTEND_URL=http://localhost:3333

# Vercel (definir no painel do projeto — serviço backend)
# CRON_SECRET=gerar-string-aleatoria-min-16-chars
# FRONTEND_URL=https://seu-dominio.vercel.app

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
