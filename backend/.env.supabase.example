# URLs para migrar Prisma Postgres -> Supabase (NAO commitar .env.supabase)
# Vercel → Storage → cada banco → aba .env.local / Connect

# Origem: prisma-postgres-almond-mountain (conexão direta / non-pooling)
SOURCE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Destino Supabase — Transaction pooler (runtime / Prisma Client), porta 6543
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Destino Supabase — conexão direta (migrations / pg_restore), porta 5432
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
