# Supabase (Vercel Storage). A integração injeta ARMAZENAMENTO_* no projeto;
# para scripts locais, copie as URLs do painel Storage → .env.local / Connect.

# Pooler (Transaction mode, porta 6543) — runtime / Prisma Client
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direta (porta 5432) — prisma migrate deploy / pg_restore
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Equivalente injetado pela Vercel (mapeado por prepare-env.js / env.ts):
# ARMAZENAMENTO_POSTGRES_PRISMA_URL=...
# ARMAZENAMENTO_POSTGRES_URL_NON_POOLING=...
