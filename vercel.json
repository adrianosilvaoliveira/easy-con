{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "routes": [
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/index.html" }
      ]
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "src/index.mjs",
      "framework": "express",
      "functions": {
        "src/index.mjs": {
          "includeFiles": "{node_modules/@prisma/**,node_modules/.prisma/**,prisma/**}",
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/_/backend/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "crons": [
    {
      "path": "/api/cron/expiration",
      "schedule": "0 6 * * *"
    }
  ]
}
