{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend/src/index.cts",
      "routePrefix": "/_/backend",
      "framework": "express",
      "includeFiles": [
        "node_modules/**",
        "backend/node_modules/**",
        "backend/prisma/**"
      ]
    }
  }
}
